<?php

/**
 *
 * @file
 * Module file for Habeuk Static Page.
 */
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_theme().
 *
 * We deliberately do NOT provide a theme hook for the public view
 * because the Controller returns raw HTML.
 * This keeps the public rendering path as light as possible.
 */
function habeuk_static_page_theme($existing, $type, $theme, $path) {
  return [
    'habeuk_email_wrap' => [
      'variables' => [
        'body' => NULL,
        'header' => NULL,
        'footer' => NULL,
        'logo' => NULL,
        'site_name' => NULL
      ]
    ]
  ];
}

/**
 * Implements template_preprocess_habeuk_email_wrap().
 */
function habeuk_static_page_preprocess_habeuk_email_wrap(array &$variables) {
  $config = \Drupal::config('system.site');
  
  // Nom du site (récupéré depuis system.site.name)
  $variables['site_name'] = $config->get('name');
  $site_slogan = $config->get('slogan');
  // Logo par défaut : chemin absolu vers un fichier du thème
  if (empty($variables['logo'])) {
    // on a un bug dans un autre module qui appeche de recuperer le bon logo. on
    // force.
    // $logo_path = \Drupal::theme()->getActiveTheme()->getLogo();
    // $variables['logo'] = \Drupal::request()->getSchemeAndHttpHost() . '/' .
    // $logo_path;
    $variables['logo'] = "https://habeuk.com/sites/default/files/styles/medium/public/2024-11/hlogo.png";
  }
  
  // En-tête : peut être configuré ailleurs, pour l'instant une valeur par
  // défaut
  if (empty($variables['header'])) {
    $variables['header'] = '<h1 style="font-size: 28px; font-weight: 900;">' . $variables['site_name'] . '</h1>';
  }
  
  // Pied de page : par défaut avec mentions légales
  if (empty($variables['footer'])) {
    $variables['footer'] = !empty($site_slogan) ? "<p> $site_slogan </p>" : '<p>Ce message a été envoyé automatiquement.</p>';
  }
}

/**
 * Implements hook_entity_type_build().
 *
 * Optional: ensure the canonical route is correctly registered.
 */
function habeuk_static_page_entity_type_build(array &$entity_types) {
  // Nothing extra needed – everything is in the annotation.
}

/**
 * Implements hook_form_alter() to improve UX on the entity form.
 */
function habeuk_static_page_form_hbk_static_page_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  // Make the textareas larger and more comfortable for pasting AI HTML.
  // string_long widgets use ['widget'][0]['value'] as well.
  foreach ([
    'header',
    'body',
    'footer'
  ] as $field) {
    if (isset($form[$field]['widget'][0]['value'])) {
      $rows = $field === 'body' ? 22 : ($field === 'header' ? 14 : 10);
      $form[$field]['widget'][0]['value']['#rows'] = $rows;
      $form[$field]['widget'][0]['value']['#attributes']['style'] = 'font-family: monospace; font-size: 13px;';
      $form[$field]['widget'][0]['value']['#attributes']['spellcheck'] = 'false';
    }
  }
}

/**
 * Pour permettre l'envoie de mail avec titre et contenu.
 * Implements hook_mail().
 */
function habeuk_static_page_mail(string $key, array &$message, array $params): void {
  if ($key !== 'test_mail') {
    return;
  }
  
  $message['subject'] = $params['subject'] ?? 'Test d\'envoi';
  $message['body'][] = $params['body'] ?? '';
  $message['headers']['Content-Type'] = 'text/html; charset=UTF-8';
}

/**
 * Implements hook_ENTITY_TYPE_insert() for hbk_static_page.
 */
function habeuk_static_page_hbk_static_page_insert(EntityInterface $entity) {
  \Drupal::service('habeuk_static_page.asset_generator')->generate($entity);
}

/**
 * Implements hook_ENTITY_TYPE_update() for hbk_static_page.
 */
function habeuk_static_page_hbk_static_page_update(EntityInterface $entity) {
  \Drupal::service('habeuk_static_page.asset_generator')->generate($entity);
}

/**
 * Implements hook_ENTITY_TYPE_delete() for hbk_static_page.
 */
function habeuk_static_page_hbk_static_page_delete(EntityInterface $entity) {
  \Drupal::service('habeuk_static_page.asset_generator')->delete($entity);
}
